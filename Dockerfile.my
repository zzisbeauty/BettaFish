# 使用您的基础镜像  
FROM videorag:latest  
  
SHELL ["/bin/bash", "-o", "pipefail", "-c"]  
  
# 设置 pip 镜像源  
ARG HTTP_PROXY  
ARG HTTPS_PROXY  
ARG NO_PROXY  
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple  
  
# 环境变量  
ENV PYTHONDONTWRITEBYTECODE=1 \  
    PYTHONUNBUFFERED=1 \  
    PIP_NO_CACHE_DIR=1 \  
    PATH="/root/.local/bin:${PATH}" \  
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright  
  
# 安装系统依赖（如果您的镜像没有）  
RUN apt-get update && apt-get install -y --no-install-recommends \  
    build-essential \  
    curl \  
    git \  
    libgl1 \  
    libglib2.0-0 \  
    libgtk-3-0 \  
    libpango-1.0-0 \  
    libpangocairo-1.0-0 \  
    libatk1.0-0 \  
    libatk-bridge2.0-0 \  
    libxcb1 \  
    libxcomposite1 \  
    libxdamage1 \  
    libxext6 \  
    libxfixes3 \  
    libxi6 \  
    libxtst6 \  
    libnss3 \  
    libxrandr2 \  
    libxkbcommon0 \  
    libasound2 \  
    libx11-xcb1 \  
    libxshmfence1 \  
    libgbm1 \  
    ffmpeg \  
    && apt-get clean && rm -rf /var/lib/apt/lists/*  
  
# 安装 uv（如果您的镜像没有）  
RUN curl -LsSf --retry 3 --retry-delay 2 --proto '=https' --proto-redir '=https' --tlsv1.2 https://astral.sh/uv/install.sh | sh  
  
WORKDIR /app  
  
# 安装 Python 依赖（使用清华源）  
COPY requirements.txt ./  
RUN pip install --no-cache-dir flask
RUN uv pip install --system -r requirements.txt  
  
# 安装 Playwright 浏览器  
RUN python -m playwright install chromium  
  
# 创建运行时目录  
RUN mkdir -p /ms-playwright logs final_reports insight_engine_streamlit_reports media_engine_streamlit_reports query_engine_streamlit_reports  
  
EXPOSE 5000 8501 8502 8503  
  
CMD ["python", "app.py"]